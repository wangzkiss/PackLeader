{
  "name": "packleader",
  "version": "0.1.0",
  "private": true,
  "description": "轻量单机 Agent：会读文件、会跑命令、会改代码，有审批、有审计、能撤销、能续跑。零依赖，Node 原生跑 TypeScript。",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "pl": "./src/cli.ts",
    "packleader": "./src/cli.ts"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.ts",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src",
    "DESIGN.md",
    "README.md"
  ]
}
